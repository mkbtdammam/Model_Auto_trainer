# ---- LLM Judge / Generator Endpoint ----
# Recommended: set full chat completions URL (OpenAI-compatible)
# Example OpenAI: https://api.openai.com/v1/chat/completions
# Example Azure OpenAI: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-06-01
LLM_CHAT_URL=

# Fallback: base url, will call {base}/chat/completions
LLM_BASE_URL=

# Secret key
LLM_API_KEY=

# Model name if required by provider
LLM_MODEL=

# Header options (defaults work for Bearer tokens)
LLM_HEADER_NAME=Authorization
LLM_HEADER_PREFIX=Bearer 

# Timeout
LLM_TIMEOUT_SECONDS=60
